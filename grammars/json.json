{
  "name": "JSON",
  "scopeName": "source.json",
  "type": "tree-sitter",
  "parser": "tree-sitter-json",
  "injectionNames": ["json"],
  "treeSitter": {
    "parserSource": "github:tree-sitter/tree-sitter-json#v0.24.8",
    "wasmBuildTool": "tree-sitter-cli#v0.27.0",
    "grammar": "json.wasm",
    "highlightsQuery": [
      "json-no-comments-highlights.scm",
      "json-highlights.scm",
      "json-no-trailing-commas-highlights.scm"
    ],
    "indentsQuery": "json-indents.scm",
    "foldsQuery": "json-folds.scm",
    "tagsQuery": "json-tags.scm"
  },
  "fileTypes": [
    "avsc",
    "babelrc",
    "bowerrc",
    "composer.lock",
    "eslintrc",
    "geojson",
    "gltf",
    "har",
    "htmlhintrc",
    "jscsrc",
    "jshintrc",
    "jslintrc",
    "json",
    "jsonl",
    "jsonld",
    "languagebabel",
    "ldj",
    "ldjson",
    "Pipfile.lock",
    "schema",
    "stylintrc",
    "template",
    "tern-config",
    "tern-project",
    "tfstate",
    "tfstate.backup",
    "topojson",
    "webapp",
    "webmanifest"
  ],
  // Comments in JSON are not strictly allowed, but lots of consumers of JSON can
  // tolerate comments in JSON files. We allow the user to opt into comments via a
  // setting.
  "comments": {
    "start": "// ",
    "block": ["/*", "*/"],
    "line": "//"
  }
}
