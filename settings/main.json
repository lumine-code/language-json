{
  ".source.json": {
    "editor": {
      "commentStart": "// ",
      "commentDelimiters": {
        "block": ["/*", "*/"],
        "line": "//"
      }
    },
    "bracket-matcher": {
      "autocompleteCharacters": ["[]", "{}", "\"\""],
      "pairsWithExtraNewline": ["[]", "{}"]
    }
  },
  ".source.jupyter": {
    "bracket-matcher": {
      "autocompleteCharacters": ["[]", "{}", "\"\""],
      "pairsWithExtraNewline": ["[]", "{}"]
    }
  },
  ".source.json5": {
    "bracket-matcher": {
      "autocompleteCharacters": ["[]", "{}", "\"\"", "''"],
      "pairsWithExtraNewline": ["[]", "{}"]
    }
  }
}
